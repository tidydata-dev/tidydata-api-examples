{
  "openapi": "3.0.0",
  "info": {
    "title": "Business Days Calculator (holidays aware)",
    "description": "Count working days between two dates and add/subtract business days, skipping weekends and the public holidays of 100+ countries and regions. Custom weekend days.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://tidydata-api.tidydata.workers.dev"
    }
  ],
  "paths": {
    "/v1/business-days": {
      "get": {
        "summary": "Business days between dates",
        "operationId": "bdays_between",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": true,
            "description": "YYYY-MM-DD",
            "schema": {
              "type": "string"
            },
            "example": "2026-12-01"
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "description": "YYYY-MM-DD",
            "schema": {
              "type": "string"
            },
            "example": "2026-12-31"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "ISO country (optional)",
            "schema": {
              "type": "string"
            },
            "example": "ES"
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "Region (optional)",
            "schema": {
              "type": "string"
            },
            "example": ""
          },
          {
            "name": "weekend",
            "in": "query",
            "required": false,
            "description": "Weekend days 0=Sun..6=Sat",
            "schema": {
              "type": "string"
            },
            "example": "6,0"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/business-days/add": {
      "get": {
        "summary": "Add business days",
        "operationId": "bdays_add",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "YYYY-MM-DD",
            "schema": {
              "type": "string"
            },
            "example": "2026-12-23"
          },
          {
            "name": "days",
            "in": "query",
            "required": true,
            "description": "Business days (negative to subtract)",
            "schema": {
              "type": "string"
            },
            "example": "3"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "ISO country",
            "schema": {
              "type": "string"
            },
            "example": "ES"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    }
  }
}