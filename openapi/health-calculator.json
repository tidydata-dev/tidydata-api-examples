            "schema": {
              "type": "string"
            },
            "example": "male"
          },
          {
            "name": "activity",
            "in": "query",
            "required": false,
            "description": "sedentary, light, moderate, active, very_active",
            "schema": {
              "type": "string"
            },
            "example": "moderate"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
