          },
          {
            "name": "hip",
            "in": "query",
            "required": false,
            "description": "Hip circumference (female only)",
            "schema": {
              "type": "string"
            },
            "example": ""
          },
          {
            "name": "sex",
            "in": "query",
            "required": true,
            "description": "male or female",
            "schema": {
              "type": "string"
            },
            "example": "male"
          },
          {
            "name": "units",
            "in": "query",
