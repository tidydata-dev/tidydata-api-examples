              "type": "string"
            },
            "example": "lose"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/health/ideal-weight": {
      "get": {
        "summary": "Ideal weight",
        "operationId": "ideal_weight",
        "parameters": [
          {
            "name": "height",
