              "type": "string"
            },
            "example": "70"
          },
          {
            "name": "height",
            "in": "query",
            "required": true,
            "description": "Height (cm, or inches if units=imperial)",
            "schema": {
              "type": "string"
            },
            "example": "175"
          },
          {
            "name": "units",
            "in": "query",
            "required": false,
            "description": "metric or imperial",
            "schema": {
              "type": "string"
            },
            "example": "metric"
          },
          {
            "name": "age",
            "in": "query",
            "required": true,
