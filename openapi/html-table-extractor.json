{
  "openapi": "3.0.0",
  "info": {
    "title": "HTML Table Extractor (to JSON or CSV)",
    "description": "Turn the HTML tables of any web page into clean JSON (rows or objects with headers) or download a table as CSV.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://tidydata-api.tidydata.workers.dev"
    }
  ],
  "paths": {
    "/v1/tables": {
      "get": {
        "summary": "Extract tables",
        "operationId": "tables",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "Page URL",
            "schema": {
              "type": "string"
            },
            "example": "https://en.wikipedia.org/wiki/Euro"
          },
          {
            "name": "index",
            "in": "query",
            "required": false,
            "description": "Table number (0 = first)",
            "schema": {
              "type": "string"
            },
            "example": "0"
          },
          {
            "name": "objects",
            "in": "query",
            "required": false,
            "description": "true = rows as objects keyed by header",
            "schema": {
              "type": "string"
            },
            "example": "true"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "json or csv",
            "schema": {
              "type": "string"
            },
            "example": "json"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    }
  }
}