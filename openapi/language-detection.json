{
  "openapi": "3.0.0",
  "info": {
    "title": "Language Detection (180+ languages)",
    "description": "Detect the language of any text: ISO 639-3 code, English name, confidence, reliability flag and top 5 candidates. Fast, no AI costs, works offline.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://tidydata-api.tidydata.workers.dev"
    }
  ],
  "paths": {
    "/v1/language": {
      "get": {
        "summary": "Detect language",
        "operationId": "language",
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "required": true,
            "description": "Text (or POST it)",
            "schema": {
              "type": "string"
            },
            "example": "Ceci est une phrase en français."
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    }
  }
}