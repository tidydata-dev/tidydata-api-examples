{
  "openapi": "3.0.0",
  "info": {
    "title": "Secure Password & UUID Generator",
    "description": "Cryptographically secure random passwords (length, symbols, numbers, uppercase, entropy) and UUID v4, in bulk.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://tidydata-api.tidydata.workers.dev"
    }
  ],
  "paths": {
    "/v1/generate/password": {
      "get": {
        "summary": "Passwords",
        "operationId": "gen_password",
        "parameters": [
          {
            "name": "length",
            "in": "query",
            "required": false,
            "description": "6-128",
            "schema": {
              "type": "string"
            },
            "example": "16"
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "description": "1-100",
            "schema": {
              "type": "string"
            },
            "example": "5"
          },
          {
            "name": "symbols",
            "in": "query",
            "required": false,
            "description": "true/false",
            "schema": {
              "type": "string"
            },
            "example": "true"
          },
          {
            "name": "numbers",
            "in": "query",
            "required": false,
            "description": "true/false",
            "schema": {
              "type": "string"
            },
            "example": "true"
          },
          {
            "name": "uppercase",
            "in": "query",
            "required": false,
            "description": "true/false",
            "schema": {
              "type": "string"
            },
            "example": "true"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/v1/generate/uuid": {
      "get": {
        "summary": "UUID v4",
        "operationId": "gen_uuid",
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "required": false,
            "description": "1-100",
            "schema": {
              "type": "string"
            },
            "example": "5"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    }
  }
}