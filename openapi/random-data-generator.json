        "summary": "Random users",
        "operationId": "users",
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "required": false,
            "description": "How many records (1-100)",
            "schema": {
              "type": "string"
            },
            "example": "10"
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "en, es, de, fr, it or pt",
            "schema": {
              "type": "string"
            },
            "example": "en"
          },
          {
            "name": "seed",
            "in": "query",
            "required": false,
            "description": "Optional seed for repeatable output",
            "schema": {
              "type": "string"
            },
            "example": ""
          }
        ],
        "responses": {
