{
  "openapi": "3.0.0",
  "info": {
    "title": "VIN Decoder API - Make Model Year Engine",
    "description": "Decode any 17-character VIN: make, model, model year, trim, body, engine, fuel, transmission, drive type and plant, plus check digit validation, region and country of manufacture. Always answers, even when the upstream registry is slow.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://tidydata-api.tidydata.workers.dev"
    }
  ],
  "paths": {
    "/v1/vin/{vin}": {
      "get": {
        "summary": "Decode VIN",
        "operationId": "decode_vin",
        "parameters": [
          {
            "name": "vin",
            "in": "path",
            "required": true,
            "description": "17-character Vehicle Identification Number",
            "schema": {
              "type": "string"
            },
            "example": "1HGCM82633A004352"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Invalid VIN"
          }
        }
      }
    }
  }
}